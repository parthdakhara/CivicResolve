@model List<CivicResolve.Models.Complaint>
@{
    ViewData["Title"] = "My Registered Grievances";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">My Grievances</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0"><i class="bi bi-person-lines-fill text-primary me-2"></i> My Grievances (Session History)</h2>
        </div>
        <div>
            <a asp-controller="Complaint" asp-action="Create" class="btn btn-primary fw-semibold">
                <i class="bi bi-plus-circle-fill me-1"></i> File New Grievance
            </a>
        </div>
    </div>

    <!-- State Management Demonstration Alert -->
    <div class="alert alert-info border-0 shadow-sm d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-cpu fs-4 me-3 text-primary"></i>
        <div>
            <div class="fw-bold">ASP.NET Core State Management (Session State)</div>
            <div class="small">This view uses <code>HttpContext.Session</code> to retain all grievances filed or tracked on your browser session without requiring permanent account registration.</div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <div class="text-muted mb-3"><i class="bi bi-inbox display-3 text-secondary"></i></div>
            <h4 class="fw-bold">No Active Grievances in this Session</h4>
            <p class="text-muted max-w-md mx-auto">
                You haven't filed any complaints during this session yet. You can also search any past complaint by its tracking code or registered mobile number.
            </p>
            <div class="d-flex justify-content-center gap-2 mt-2">
                <a asp-controller="Complaint" asp-action="Create" class="btn btn-primary">File a Grievance</a>
                <a asp-controller="Complaint" asp-action="Track" class="btn btn-outline-secondary">Track Past Grievance</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <span class="fw-bold text-dark">Active Session Complaints (@Model.Count)</span>
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1">Session Active</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th>Tracking ID</th>
                            <th>Issue Title</th>
                            <th>Department & Category</th>
                            <th>Location</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Submitted On</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold text-primary font-monospace">@c.TrackingNumber</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark text-truncate" style="max-width: 250px;">@c.Title</div>
                                </td>
                                <td>
                                    <div class="small fw-bold">@c.Department?.Code</div>
                                    <div class="small text-muted text-truncate" style="max-width: 180px;">@c.Category?.Name</div>
                                </td>
                                <td>
                                    <div class="small text-muted"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Ward @c.WardNumber</div>
                                </td>
                                <td>
                                    <span class="badge @(c.Priority == CivicResolve.Models.ComplaintPriority.Critical ? "bg-danger" : c.Priority == CivicResolve.Models.ComplaintPriority.High ? "bg-warning text-dark" : "bg-info text-dark")">
                                        @c.Priority
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(c.Status == CivicResolve.Models.ComplaintStatus.Resolved ? "bg-success" : c.Status == CivicResolve.Models.ComplaintStatus.InProgress ? "bg-primary" : "bg-warning text-dark")">
                                        @c.Status
                                    </span>
                                </td>
                                <td class="small text-muted">
                                    @c.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Complaint" asp-action="Track" asp-route-q="@c.TrackingNumber" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> View Live
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
