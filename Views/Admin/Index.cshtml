@model CivicResolve.Models.ViewModels.ComplaintFilterViewModel
@{
    ViewData["Title"] = "Manage Municipal Grievances";
}

<div class="container-fluid py-4 px-lg-5">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Admin</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Grievance Management</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0"><i class="bi bi-list-check text-primary me-2"></i> Municipal Grievance Directory</h2>
        </div>

        <div class="d-flex gap-2 mt-3 mt-md-0">
            <a asp-action="ExportCsv" class="btn btn-outline-success btn-sm fw-semibold">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
            </a>
            <a asp-controller="Complaint" asp-action="Create" class="btn btn-primary btn-sm fw-semibold">
                <i class="bi bi-plus-circle-fill me-1"></i> Lodge Grievance
            </a>
        </div>
    </div>

    <!-- Filter & Search Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3 p-md-4">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Search Keywords</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="ID, Title, Citizen, Mobile..." />
                    </div>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Department</label>
                    <select name="DepartmentId" class="form-select form-select-sm">
                        <option value="">-- All Depts --</option>
                        @foreach (var dept in Model.Departments)
                        {
                            <option value="@dept.Id" selected="@(Model.DepartmentId == dept.Id)">@dept.Name</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Status</label>
                    <select name="Status" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<CivicResolve.Models.ComplaintStatus>()">
                        <option value="">-- All Statuses --</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Priority</label>
                    <select name="Priority" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<CivicResolve.Models.ComplaintPriority>()">
                        <option value="">-- All Priorities --</option>
                    </select>
                </div>

                <div class="col-md-1">
                    <label class="form-label small fw-semibold">Ward No.</label>
                    <input type="number" name="WardNumber" value="@Model.WardNumber" class="form-control form-control-sm" placeholder="Any" min="1" max="150" />
                </div>

                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">
                        <i class="bi bi-funnel-fill me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Clear Filters">
                        <i class="bi bi-x-circle"></i>
                    </a>
                </div>

                <div class="col-12 mt-2">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="OnlyOverdue" value="true" id="checkOverdue" @(Model.OnlyOverdue == true ? "checked" : "") onchange="this.form.submit()">
                        <label class="form-check-label small text-danger fw-bold" for="checkOverdue">
                            <i class="bi bi-alarm-fill me-1"></i> Show Only SLA Overdue Grievances
                        </label>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark">Found @Model.TotalItems Grievances</span>
            <span class="small text-muted">Page @Model.CurrentPage of @(Model.TotalPages == 0 ? 1 : Model.TotalPages)</span>
        </div>

        @if (!Model.Complaints.Any())
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-folder-x display-4 text-secondary mb-3 d-block"></i>
                <h5 class="fw-bold">No grievances match the specified criteria.</h5>
                <p class="small">Try resetting your filters or search keywords.</p>
                <a asp-action="Index" class="btn btn-outline-primary btn-sm">Reset Filters</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th>Tracking ID</th>
                            <th>Subject & Complainant</th>
                            <th>Department & Category</th>
                            <th>Ward / Location</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>SLA Deadline</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Complaints)
                        {
                            <tr class="@(c.IsOverdue ? "table-danger bg-opacity-25" : "")">
                                <td>
                                    <span class="fw-bold text-primary font-monospace">@c.TrackingNumber</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark text-truncate" style="max-width: 240px;">@c.Title</div>
                                    <div class="small text-muted">@c.CitizenName • <i class="bi bi-telephone"></i> @c.CitizenPhone</div>
                                </td>
                                <td>
                                    <div class="small fw-bold">@c.Department?.Code</div>
                                    <div class="small text-muted text-truncate" style="max-width: 170px;">@c.Category?.Name</div>
                                </td>
                                <td>
                                    <div class="small text-dark fw-semibold"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Ward @c.WardNumber</div>
                                    <div class="small text-muted text-truncate" style="max-width: 150px;">@c.Address</div>
                                </td>
                                <td>
                                    <span class="badge @(c.Priority == CivicResolve.Models.ComplaintPriority.Critical ? "bg-danger" : c.Priority == CivicResolve.Models.ComplaintPriority.High ? "bg-warning text-dark" : "bg-info text-dark")">
                                        @c.Priority
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(c.Status == CivicResolve.Models.ComplaintStatus.Resolved ? "bg-success" : c.Status == CivicResolve.Models.ComplaintStatus.InProgress ? "bg-primary" : "bg-warning text-dark")">
                                        @c.Status
                                    </span>
                                </td>
                                <td>
                                    <div class="small @(c.IsOverdue ? "text-danger fw-bold" : "text-muted")">
                                        @(c.SlaDeadline?.ToString("dd MMM, HH:mm") ?? "N/A")
                                        @if (c.IsOverdue)
                                        {
                                            <span class="badge bg-danger d-block mt-1">Overdue</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-outline-secondary" title="View Dossier">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="EditStatus" asp-route-id="@c.Id" class="btn btn-outline-primary" title="Update Status">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" title="Delete Complaint" data-bs-toggle="modal" data-bs-target="#deleteModal_@c.Id">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Delete Modal -->
                                    <div class="modal fade text-start" id="deleteModal_@c.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header bg-danger text-white">
                                                    <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Deletion</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p>Are you sure you want to permanently delete complaint <strong>@c.TrackingNumber</strong>?</p>
                                                    <div class="p-2 bg-light rounded small text-muted border">
                                                        <strong>Title:</strong> @c.Title<br />
                                                        <strong>Citizen:</strong> @c.CitizenName
                                                    </div>
                                                    <p class="text-danger small mt-2 mb-0"><i class="bi bi-info-circle me-1"></i> This action removes all status history and citizen feedback records.</p>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger btn-sm">Yes, Delete Record</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center">
                    <span class="small text-muted">Showing page @Model.CurrentPage of @Model.TotalPages</span>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-CurrentPage="@(Model.CurrentPage - 1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-DepartmentId="@Model.DepartmentId" asp-route-Status="@Model.Status" asp-route-Priority="@Model.Priority" asp-route-WardNumber="@Model.WardNumber" asp-route-OnlyOverdue="@Model.OnlyOverdue">Previous</a>
                            </li>
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(Model.CurrentPage == p ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-CurrentPage="@p" asp-route-SearchTerm="@Model.SearchTerm" asp-route-DepartmentId="@Model.DepartmentId" asp-route-Status="@Model.Status" asp-route-Priority="@Model.Priority" asp-route-WardNumber="@Model.WardNumber" asp-route-OnlyOverdue="@Model.OnlyOverdue">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-CurrentPage="@(Model.CurrentPage + 1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-DepartmentId="@Model.DepartmentId" asp-route-Status="@Model.Status" asp-route-Priority="@Model.Priority" asp-route-WardNumber="@Model.WardNumber" asp-route-OnlyOverdue="@Model.OnlyOverdue">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>
